generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────
// USERS
// ──────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("mentee") // "admin" | "mentor" | "mentee"
  avatar                String?
  resetToken            String?
  resetTokenExpiresAt   DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Mentor relations
  mentorPairings Pairing[] @relation("MentorPairings")

  // Mentee relations
  menteePairings Pairing[] @relation("MenteePairings")

  // Notifications
  notifications Notification[]

  // Profiles
  mentorProfile MentorProfile?
  menteeProfile MenteeProfile?

  // Schedule
  scheduleSlots    ScheduleSlot[]    @relation("MentorSlots")
  scheduleBookings ScheduleBooking[] @relation("MenteeBookings")

  // Mentor partnership contract
  mentorContract MentorContract?
}

model MentorProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  // Study Experience
  fullName           String?
  city               String?
  undergradMajor     String?
  undergradUniversity String?
  postgradMajor      String?
  postgradUniversity  String?
  fundingScheme      String?  // "lpdp" | "self-funded" | "other"
  fundingOther       String?
  currentField       String?
  currentFieldOther  String?
  // Mentoring Preference
  personality        String?  // "introvert" | "extrovert" | "ambivert"
  mentorStyle        String?  // "gentle" … "direct"
  workStyle          String?  // "structured" … "flexible"
  communicationStyle String?  // "casual" … "formal"
  primaryRoles       String?  // JSON array, max 2

  // Identity (used by Perjanjian Kemitraan Mentor — see MentorContract)
  // Stored as String? to mirror MenteeProfile conventions and keep
  // form-binding simple (HTML date inputs return strings).
  placeOfBirth       String?
  dateOfBirth        String?  // "YYYY-MM-DD"
  idType             String?  // "KTP" | "Paspor"
  idNumber           String?
  npwp               String?
  legalAddress       String?  // alamat resmi sesuai KTP/paspor
  phoneNumber        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MenteeProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique

  // Personal Information
  fullLegalName      String?
  dateOfBirth        String?
  studentId          String?
  phoneNumber        String?

  // National ID / Identity
  idNumber           String?
  nationality        String?
  passportNumber     String?
  currentAddress     String?
  legalAddress       String?

  // Academic Background
  mostRecentSchool   String?
  levelOfStudy       String?
  curriculum         String?
  gpa                String?

  // Goals and Preferences
  intendedStudyProgram    String?
  intendedMajor           String?
  preferredDestinations   String?
  preferredIntakeMonth    String?
  preferredIntakeYear     String?
  preferredEarliestIntake String?
  postGraduationPlan      String?

  // Test Preparation
  englishTestStatus  String?
  englishTestType    String?
  englishTestDate    String?
  englishTestScore   String?

  // Visa Status
  hasAppliedVisa              Boolean?
  familyAppliedVisa           Boolean?
  hasRelativesInStudyCountry  Boolean?
  hasPermanentResidency       Boolean?

  // Funding
  fundingSource      String?
  studyBudget        String?

  // Mentoring Preferences
  preferredPersonality    String?  // "introvert" | "extrovert" | "ambivert" | "not-sure"
  preferredMentoringStyle String?  // "gentle" … "direct"
  preferredWorkingStyle   String?  // "structured" … "flexible"
  preferredCommStyle      String?  // "formal" … "casual"
  preferredRoles          String?  // JSON array, max 2

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// SCHEDULE
// ──────────────────────────────────────────────

model ScheduleSlot {
  id        String   @id @default(cuid())
  mentorId  String
  date      String   // "YYYY-MM-DD"
  startTime String   // "HH:MM"
  endTime   String   // "HH:MM"
  notes     String?
  status    String   @default("available") // "available" | "pending" | "booked"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentor   User              @relation("MentorSlots", fields: [mentorId], references: [id], onDelete: Cascade)
  bookings ScheduleBooking[]
}

model ScheduleBooking {
  id             String   @id @default(cuid())
  slotId         String
  menteeId       String
  message        String?
  sessionId      String?  // FK to Session being discussed
  requestedStart String?  // "HH:MM" — chosen 90-min window start
  requestedEnd   String?  // "HH:MM" — chosen 90-min window end
  status                String   @default("pending") // "pending" | "accepted" | "rejected"
  rejectionReason       String?  // Mandatory reason filled by mentor on rejection
  googleCalendarEventId String?  // Google Calendar event ID for cleanup
  googleMeetLink        String?  // Google Meet join URL
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  slot   ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  mentee User         @relation("MenteeBookings", fields: [menteeId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// MENTOR-MENTEE PAIRING
// ──────────────────────────────────────────────

model Pairing {
  id        String   @id @default(cuid())
  mentorId  String
  menteeId  String
  status    String   @default("active") // "active" | "completed" | "paused"
  track     String   @default("full") // "full" (10 sessions) — extensible later
  startDate DateTime @default(now())
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentor  User      @relation("MentorPairings", fields: [mentorId], references: [id])
  mentee  User      @relation("MenteePairings", fields: [menteeId], references: [id])

  sessions       Session[]
  documents      Document[]
  tasks          Task[]
  progressNotes  ProgressNote[]

  // Mentee profile data
  targetProgram     String?
  priorityUnis      String? // JSON array of university names
  ieltsScore        String?
  northStarCard     String? // Mentor's north star card for this pairing

  @@unique([mentorId, menteeId])
}

// ──────────────────────────────────────────────
// SESSIONS (10-session curriculum)
// ──────────────────────────────────────────────

model Session {
  id          String   @id @default(cuid())
  pairingId   String
  sessionNum  Int      // 1-10
  phase       String   // "discovery" | "planning" | "writing" | "execution" | "closing"
  topic       String   // e.g. "Perkenalan & Profil Mentee"
  status      String   @default("upcoming") // "upcoming" | "scheduled" | "completed" | "skipped"
  scheduledAt DateTime?
  completedAt DateTime?

  // Session tracking
  mentorRating    Int?   // 1-5 (mentee rates the mentor)
  menteeEnergy    Int?   // 1-5 (mentor observes mentee energy)
  keyOutput       String?
  obstacles       String?
  summaryNotes    String? // 24-hour post-session summary
  menteeFeedback  String? // Mentee's impression/comment about the session

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pairing Pairing @relation(fields: [pairingId], references: [id], onDelete: Cascade)

  @@unique([pairingId, sessionNum])
}

// ──────────────────────────────────────────────
// DOCUMENTS (upload, review, approve)
// ──────────────────────────────────────────────

model Document {
  id          String   @id @default(cuid())
  pairingId   String
  category    String   // "cv" | "motivation_letter" | "transcript" | "ielts" | "recommendation" | "essay_lpdp" | "other"
  name        String
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  status      String   @default("uploaded") // "uploaded" | "under_review" | "needs_revision" | "approved"
  version     Int      @default(1)
  uploadedBy  String   // userId
  feedback    String?  // Mentor feedback on this document

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pairing Pairing @relation(fields: [pairingId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// TASKS / HOMEWORK
// ──────────────────────────────────────────────

model Task {
  id          String   @id @default(cuid())
  pairingId   String
  sessionNum  Int?     // Which session this task relates to
  title       String
  description String?
  status      String   @default("pending") // "pending" | "in_progress" | "completed" | "overdue"
  dueDate     DateTime?
  assignedBy  String   // userId (mentor)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pairing Pairing @relation(fields: [pairingId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// PROGRESS NOTES (per-session reflections)
// ──────────────────────────────────────────────

model ProgressNote {
  id         String   @id @default(cuid())
  pairingId  String
  sessionNum Int?
  authorId   String   // userId
  content    String
  type       String   @default("note") // "note" | "achievement" | "concern" | "action_item"

  createdAt DateTime @default(now())

  pairing Pairing @relation(fields: [pairingId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// NOTIFICATIONS
// ──────────────────────────────────────────────

model Notification {
  id      String   @id @default(cuid())
  userId  String
  title   String
  message String
  type    String   @default("info") // "info" | "task" | "document" | "session" | "alert"
  read    Boolean  @default(false)
  link    String?  // URL to navigate to

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// MENTOR PARTNERSHIP CONTRACT
// ──────────────────────────────────────────────
// Backs the "Perjanjian Kemitraan Mentor" digital signing flow under
// /dashboard/contract (mentor) and /dashboard/admin/contracts (admin).
// One contract per mentor; voiding preserves the record but flags it,
// allowing the mentor to re-sign with a new contractNumber.

model MentorContract {
  id              String    @id @default(cuid())
  userId          String    @unique

  contractNumber  String    @unique         // e.g. "001/ST-MTR/V/2026"
  status          String                    // "PENDING_SIGNATURE" | "SIGNED" | "VOID"
  templateVersion String                    // pinned at sign time, e.g. "2026.05.10"

  // Frozen at sign time so future MentorProfile edits don't mutate the
  // signed record. JSON shape: { fullName, placeOfBirth, dateOfBirth,
  // idType, idNumber, npwp, legalAddress, phoneNumber }.
  identitySnapshot Json?

  signatureDataUrl String?   @db.Text       // base64 PNG of drawn signature
  signedAt         DateTime?
  signatureHash    String?                  // sha256(version + snapshot + dataUrl)
  ipAddress        String?
  userAgent        String?   @db.Text

  pdfPath          String?                  // Supabase storage path

  voidedAt         DateTime?
  voidReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ────────────────────────────────────────────────────────────────────────
// Leads pipeline — Tally → bucket → outreach → match
// ────────────────────────────────────────────────────────────────────────

enum LeadBucket {
  A
  B
  C
  D
  incomplete   // Tally target field left blank — re-engage to fill it
  domestic     // Target is an Indonesian university (out of scope)
  unclassified
}

enum LeadStage {
  new
  outreach_sent
  whatsapp_read     // lead saw WA (status=read from Fonnte webhook)
  email_opened      // lead opened email (Resend webhook tracking pixel)
  email_clicked     // lead clicked link inside email
  call_scheduled
  call_completed
  deposit_pending
  deposit_agreed     // mentee confirmed willingness to pay deposit, transfer not yet in
  deposit_paid       // deposit lunas — transfer confirmed
  matched
  declined
  waitlist
  rejected
}

model Lead {
  id                     String     @id @default(cuid())
  // From Tally
  name                   String
  email                  String
  whatsappNumber         String?
  targetCampusAndProgram String
  fundingPlan            String     // "scholarship" | "self_funded" | "partial"
  submittedAt            DateTime   @default(now())
  tallySubmissionId      String?    @unique
  // System-derived
  bucket                 LeadBucket @default(unclassified)
  bucketReason           String?
  parsedCountry          String?
  parsedCampus           String?
  parsedField            String?    // "STEM" | "Business" | "unclear"
  isCampusPartner        Boolean?
  hasCountryMentor       Boolean    @default(false)
  // Funnel state
  stage                  LeadStage  @default(new)
  outreachSentAt         DateTime?
  emailOpenedAt          DateTime?
  emailClickedAt         DateTime?
  // WA engagement timestamps — denormalized from OutreachLog so the
  // list endpoint can show per-channel state without aggregation.
  // Mirrors the email* fields above.
  whatsappSentAt         DateTime?
  whatsappReadAt         DateTime?
  callScheduledAt        DateTime?
  callCompletedAt        DateTime?
  // Google Calendar event ID for the most recent call_scheduled booking.
  // Lets the calendar sync detect cancellations (events flipping to
  // status=cancelled) and revert the stage. Cleared when reverted.
  calendarEventId        String?
  // Decision
  assignedInterviewer    String?    // "Razak" | "Venzo"
  depositTier            Int?       // 1 | 2 | 3
  readinessScore         Int?       // 0–5
  callNotes              String?
  redFlags               String?
  decision               String?    // "proceed" | "waitlist" | "declined_by_student" | "rejected_by_us"
  mentorMatchedId        String?
  // Phase 15: mandatory classification review gate. New leads land with
  // these all null; admin must explicitly confirm classification (or
  // override the bucket) before any outreach — auto or manual — can
  // send. Cleared automatically when re-classification changes the
  // bucket. `classificationReviewedBy` stores a User.id or the literal
  // "system_backfill" sentinel for the one-shot migration backfill.
  classificationReviewedAt  DateTime?
  classificationReviewedBy  String?
  classificationReviewNote  String?
  // Bookkeeping
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  history                LeadStageHistory[]
  outreach               OutreachLog[]
  stepStatuses           LeadStepStatus[]
  notes                  LeadNote[]
  mentorFlags            MentorLeadFlag[]
  mentorViews            MentorLeadView[]

  @@index([bucket])
  @@index([stage])
  @@index([parsedCountry])
  @@index([submittedAt])
  @@index([email])
  @@index([calendarEventId])
  @@index([classificationReviewedAt])
}

/**
 * Phase 13: mentors leave top-level notes on incoming leads; admins
 * reply with 1-level threading (parentNoteId set). API enforces:
 *   - top-level (parentNoteId=null) → author must be mentor
 *   - reply (parentNoteId=X) → author must be admin AND parent must be top-level
 *   - edit window: 15 minutes after createdAt; editedAt records the
 *     change. No delete.
 */
model LeadNote {
  id           String    @id @default(cuid())
  leadId       String
  authorId     String    // User.id (mentor for top-level, admin for replies)
  parentNoteId String?
  content      String
  editedAt     DateTime?
  createdAt    DateTime  @default(now())

  lead    Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  parent  LeadNote?  @relation("LeadNoteReplies", fields: [parentNoteId], references: [id], onDelete: Cascade)
  replies LeadNote[] @relation("LeadNoteReplies")

  @@index([leadId])
  @@index([authorId])
  @@index([parentNoteId])
}

/**
 * Phase 16: per-mentor view-state of a lead. Lets us flag "admin
 * replied since you last looked" without firing a notification for
 * every reply. Upserted whenever the mentor opens the lead's detail
 * slide-over. Absence (no row) = mentor never opened this lead →
 * any admin reply counts as unread.
 */
model MentorLeadView {
  id            String   @id @default(cuid())
  mentorId      String   // User.id (role=mentor)
  leadId        String
  lastViewedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([mentorId, leadId])
  @@index([mentorId])
  @@index([leadId])
}

/** Phase 13: mentor flags a lead they personally know. Surfaced to
 *  admin as a chip with optional context one-liner. Unique per
 *  (lead, mentor) — toggle by POST/DELETE. */
model MentorLeadFlag {
  id        String   @id @default(cuid())
  leadId    String
  mentorId  String   // User.id (role=mentor)
  context   String?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, mentorId])
  @@index([leadId])
  @@index([mentorId])
}

model LeadStageHistory {
  id        String   @id @default(cuid())
  leadId    String
  fromStage String?
  toStage   String
  changedBy String   // userId or "tally-webhook" / "resend-webhook" / "cron"
  note      String?
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model OutreachLog {
  id              String    @id @default(cuid())
  leadId          String
  channel         String    @default("email")
  templateUsed    String    // "bucket_a_b_d" | "bucket_c" | "custom"
  subject         String
  body            String
  sentAt          DateTime  @default(now())
  status          String    @default("sent") // "sent" | "bounced" | "failed"
  resendMessageId String?   @unique
  openedAt        DateTime?
  clickedAt       DateTime?
  bouncedAt       DateTime?
  errorMessage    String?

  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([resendMessageId])
}

model LeadStepDefinition {
  id          String   @id @default(cuid())
  order       Int      // display order; admin reorderable via drag
  label       String   // "Kirim email pertama", "Schedule initial call", ...
  description String?
  // When non-null, auto-completes the moment that system event fires.
  // null = manual-only.
  autoTrigger String?  // "email_sent" | "email_opened" | "email_clicked" | "deposit_paid" | "matched" | null
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  statuses    LeadStepStatus[]

  @@index([order])
  @@index([isActive])
}

model LeadStepStatus {
  id          String              @id @default(cuid())
  leadId      String
  stepId      String
  status      String              @default("pending") // "pending" | "done" | "skipped"
  completedAt DateTime?
  completedBy String?             // userId or literal "system"
  note        String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  lead        Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  step        LeadStepDefinition  @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([leadId, stepId])
  @@index([leadId])
  @@index([status])
}

model LeadEmailTemplate {
  id        String   @id @default(cuid())
  // One of TEMPLATE_BUCKETS in src/lib/leads/types.ts:
  //   "A_B_C"      → invitation (mentor or partner kampus available)
  //   "D"          → polite confirmation (outside our network)
  //   "incomplete" → re-engage (target field blank in Tally)
  //   "domestic"   → polite decline (target in Indonesia, out of scope)
  bucket    String   @unique
  subject   String
  body      String   // plain text with {{name}}, {{campusJurusan}}, {{fundingPlan}} tokens
  // Optional WhatsApp variant — shorter, conversational. Same tokens.
  // Null = WA channel skips this template (admin hasn't authored a WA version).
  whatsappBody String?
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model LeadAutoSendSetting {
  id           String    @id @default("singleton")
  enabled      Boolean   @default(false)
  delayMinutes Int       @default(60)   // min effective granularity = Vercel cron interval (5 min)
  lastRunAt    DateTime?
  updatedAt    DateTime  @updatedAt
  updatedBy    String?
}

// ────────────────────────────────────────────────────────────────────────
// Google Calendar OAuth — single row holding the long-lived refresh
// token for admin@satutuju.id's calendar. The cron + manual sync
// endpoints exchange this for a short-lived access token to call the
// Google Calendar API. One row per app (id="singleton") because we only
// track Razak's appointment-schedule calendar at the moment.
// ────────────────────────────────────────────────────────────────────────
model GoogleCalendarAuth {
  id               String    @id @default("singleton")
  refreshToken     String                       // long-lived OAuth refresh token
  scope            String                       // requested scopes (space-separated)
  googleEmail      String?                      // email of the connected Google account
  connectedAt      DateTime  @default(now())
  connectedBy      String?                      // userId of the admin who did the OAuth dance
  lastSyncAt       DateTime?                    // last successful events.list run
  lastSyncToken    String?                      // Google's sync token for incremental fetch
  updatedAt        DateTime  @updatedAt
}
