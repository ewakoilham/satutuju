# Database (Supabase PostgreSQL)
# Get these from: Supabase Dashboard > Project Settings > Database
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Auth
JWT_SECRET="generate-a-strong-random-secret-here"

# Email outreach (Resend)
# Get RESEND_API_KEY from https://resend.com/api-keys
RESEND_API_KEY="re_..."
# After registering ${APP_URL}/api/webhooks/resend in Resend Dashboard
# → Webhooks, copy the signing secret here.
RESEND_WEBHOOK_SECRET="whsec_..."

# Tally form ingestion (admin pulls submissions via REST API)
TALLY_API_KEY="tly-..."

# App URL — used in email links + as base for webhook URLs
APP_URL="https://satutuju.id"

# Vercel cron auth — Vercel injects this header automatically when
# invoking cron routes. Set the same value here to verify origin.
CRON_SECRET="generate-a-strong-random-secret-here"

# Google Calendar API — used to detect when leads book the appointment
# schedule (Razak's admin@satutuju.id calendar). Owner of the calendar
# must sign in once via /api/auth/google to authorize; refresh_token is
# stored in the GoogleCalendarAuth singleton row in DB.
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_REDIRECT_URI="https://www.satutuju.id/api/auth/google/callback"

# Fonnte WhatsApp gateway — outbound WA messages for lead reachout.
# Get the token from Fonnte Dashboard > Devices > select your device.
# The reachout flow falls back to email-only if this var is unset.
FONNTE_API_KEY="your-fonnte-device-token"
# WA device number (digits-only, with country code) — used to validate
# inbound Fonnte webhook payloads come from OUR device, not someone
# else's spoofed POST. Example: "6285726286788"
FONNTE_DEVICE_NUMBER="6285726286788"
# REQUIRED shared-secret check on the Fonnte webhook. The webhook payload
# must include `token=<this value>` (configure in Fonnte dashboard's
# webhook URL with ?token=... query OR custom header — depends on Fonnte
# version). The webhook route fails closed (500) if this is unset, so an
# attacker can't forge WA delivery/read events. Generate a strong random.
FONNTE_WEBHOOK_SECRET="generate-a-strong-random-secret-here"
